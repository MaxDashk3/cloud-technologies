@using System.Text.Json
@{
    ViewData["Title"] = "Translator";
    Dictionary<string, string> languages = ViewBag.languages;
}
@model WebApplication1.Models.TranslatorModel

<h2>Translator</h2>

<form asp-action="Index" method="post">
    <div>
        <label for="inputText">Text to Translate:</label><br />
        <textarea id="inputText" name="inputText" rows="4" cols="50">@(Model!=null? Model.text: "")</textarea>
    </div>
    <div>
        <label for="language">Select Language:</label>
        <select id="language" name="targetLanguage">
            @foreach (var language in languages)
            {
                <option value="@language.Key"
                selected="@(Model != null && Model.targetLanguage == language.Key ? "selected" : null)">
                    @language.Value
                </option>
            }
        </select>
    </div>
    @if(Model!=null){
    <p style="color: dimgray">Detected language: @languages[Model.sourceLanguage]</p>
    }
    <input type="submit" class="btn btn-primary" value="Translate">
</form>

@if (Model!=null)
{
    <hr />
    <h3>Translated Text:</h3>
    <p>@Model.translatedText</p>
}
<br />
<a asp-action="TestCreator" class="btn btn-secondary">Create a test</a>
