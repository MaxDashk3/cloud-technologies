@{
	ViewData["Title"] = "Censor PII";
}
<h1>Result:</h1>
<img style="max-width: 500px; width: 100%" src="@Url.Action("DisplayImage", "ImageAnalysis")" alt="Uploaded Image" /><br />
<button onclick="downloadImage()" class="btn btn-primary">Download Image</button>

<script>
function downloadImage() {
    const imageUrl = "/ImageAnalysis/DisplayImage"; 
    const link = document.createElement("a");
    link.href = imageUrl;
    link.download = "censored_image.png";
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
}
</script>
